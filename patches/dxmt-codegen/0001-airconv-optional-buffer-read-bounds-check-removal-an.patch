+template <typename Handle>
+llvm::Value *
+Converter::CreateBufferPtrImpl(Handle &Buffer, llvm::Value *Index, unsigned Count, bool BoundCheck) {
+  llvm::Value *Addr = ir.CreateGEP(ir.getInt32Ty(), Buffer.Pointer, {Index});
+  if (Count > 1) {
+    auto AS = cast<llvm::PointerType>(Buffer.Pointer->getType())->getAddressSpace();
+    Addr = ir.CreateBitCast(Addr, air.getIntTy(Count)->getPointerTo(AS));
+  }
+  if (!BoundCheck || !Buffer.Metadata) {
+    return Addr;
+  }
+  auto Last = Count > 1 ? ir.CreateAdd(Index, ir.getInt32(Count - 1)) : Index;
+  auto ByteLength = DecodeRawBufferByteLength(Buffer.Metadata);
+  return ir.CreateSelect(
+      ir.CreateICmpULT(Last, ir.CreateLShr(ByteLength, 2)), Addr, llvm::Constant::getNullValue(Addr->getType())
+  );
+}
+
+llvm::Value *
+Converter::CreateBufferReadPtr(BufferResourceHandle &Buffer, llvm::Value *Index, unsigned Count) {
+  return CreateBufferPtrImpl(Buffer, Index, Count, !air.getOptions().noBufferReadBoundsCheck);
+}
+
+llvm::Value *
+Converter::LoadBufferDwords(BufferResourceHandle &Buffer, llvm::Value *Index, mask_t AccessMask, bool Volatile) {
+  llvm::Value *ValueVec = llvm::PoisonValue::get(air.getIntTy(4));
+  AccessMask &= kMaskAll;
+  if (!AccessMask)
+    return ValueVec;
+  unsigned Lo = __builtin_ctz(AccessMask);
+  unsigned Hi = 31 - __builtin_clz(AccessMask);
+  unsigned Count = Hi - Lo + 1;
+  if (air.getOptions().vectorizeBufferLoads && !Buffer.GlobalCoherent && Count > 1) {
+    // a single <Count x i32> load; only dword alignment is guaranteed by D3D
+    auto Ptr = CreateBufferReadPtr(Buffer, ir.CreateAdd(Index, ir.getInt32(Lo)), Count);
+    auto Loaded = ir.CreateAlignedLoad(air.getIntTy(Count), Ptr, llvm::Align(4), Volatile);
+    llvm::SmallVector<int, 4> Shuffle;
+    for (unsigned I = 0; I < 4; I++)
+      Shuffle.push_back((I >= Lo && I <= Hi) ? int(I - Lo) : -1);
+    return ir.CreateShuffleVector(Loaded, Shuffle);
+  }
+  for (auto [DstComp, _] : EnumerateComponents(AccessMask)) {
+    auto Ptr = CreateBufferReadPtr(Buffer, ir.CreateAdd(Index, ir.getInt32(DstComp)), 1);
+    auto ValueInt = Buffer.GlobalCoherent ? (llvm::Value *)air.CreateDeviceCoherentLoad(ir.getInt32Ty(), Ptr)
+                                          : (llvm::Value *)ir.CreateLoad(ir.getInt32Ty(), Ptr, Volatile);
+    ValueVec = ir.CreateInsertElement(ValueVec, ValueInt, DstComp);
+  }
+  return ValueVec;
+}
+
+void
+Converter::StoreBufferDwords(AtomicBufferResourceHandle &Buffer, llvm::Value *Index, llvm::Value *Value, bool Volatile) {
+  // store masks are always contiguous from x (checked by the caller)
+  unsigned Count = 32 - __builtin_clz(Buffer.Mask & kMaskAll);
+  auto VecTy = dyn_cast<llvm::FixedVectorType>(Value->getType());
+  if (air.getOptions().vectorizeBufferStores && !Buffer.GlobalCoherent && Count > 1 && VecTy &&
+      VecTy->getElementType()->isIntegerTy(32) && VecTy->getNumElements() >= Count) {
+    auto Ptr = CreateBufferPtrImpl(Buffer, Index, Count, true);
+    llvm::SmallVector<int, 4> Shuffle;
+    for (unsigned I = 0; I < Count; I++)
+      Shuffle.push_back(I);
+    llvm::Value *Vec = Value;
+    if (VecTy->getNumElements() != Count)
+      Vec = ir.CreateShuffleVector(Value, Shuffle);
+    ir.CreateAlignedStore(Vec, Ptr, llvm::Align(4), Volatile);
+    return;
+  }
+  for (auto [DstComp, _] : EnumerateComponents(Buffer.Mask)) {
+    auto Ptr = CreateGEPInt32WithBoundCheck(Buffer, ir.CreateAdd(Index, ir.getInt32(DstComp)));
+    if (Buffer.GlobalCoherent)
+      air.CreateDeviceCoherentStore(ExtractElement(Value, DstComp), Ptr);
+    else
+      ir.CreateStore(ExtractElement(Value, DstComp), Ptr, Volatile);
+  }
+}
+
