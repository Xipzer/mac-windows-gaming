From 762e599c7e1cf2f988cc6ff22740184699561917 Mon Sep 17 00:00:00 2001
From: Xipz <xipz@192.168.1.107>
Date: Tue, 20 Oct 2026 15:11:10 +0100
Subject: [PATCH 4/9] d3d11: on constant buffer discard only dirty slots the
 buffer is bound to

---
 src/d3d11/d3d11_context_imm.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index 17c049c..8ec4c88 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -156,8 +156,13 @@ public:
           state_.InputAssembler.VertexBuffers.set_dirty();
         }
         if (bind_flag & D3D11_BIND_CONSTANT_BUFFER) {
+          // only the slots this buffer is bound to need their argument tables re-encoded
+          IUnknown *raw = pResource;
           for (auto &stage : state_.ShaderStages) {
-            stage.ConstantBuffers.set_dirty();
+            for (const auto &[slot, entry] : stage.ConstantBuffers) {
+              if (entry.RawPointer == raw)
+                stage.ConstantBuffers.set_dirty(slot);
+            }
           }
         }
         if (bind_flag & D3D11_BIND_SHADER_RESOURCE) {
