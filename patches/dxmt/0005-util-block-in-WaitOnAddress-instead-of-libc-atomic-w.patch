diff --git a/src/util/util_atomic_wait.hpp b/src/util/util_atomic_wait.hpp
new file mode 100644
index 0000000..450bd4d
--- /dev/null
+++ b/src/util/util_atomic_wait.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <atomic>
+#include <type_traits>
+
+#ifdef _WIN32
+#include <windows.h>
+#include <synchapi.h>
+#endif
+
+namespace dxmt {
+
+/**
+ * std::atomic::wait in mingw libc++ has no native wait on Windows: it polls with
+ * SwitchToThread and Sleep(elapsed / 2), which burns CPU and oversleeps by up to half
+ * the wait time. These helpers block in WaitOnAddress instead (Wine maps it to
+ * NtWaitForAlertByThreadId).
+ */
+template <typename T>
+inline void
+atomic_wait(const std::atomic<T> &atomic, std::type_identity_t<T> old, std::memory_order order = std::memory_order_seq_cst) {
+#ifdef _WIN32
+  static_assert(sizeof(std::atomic<T>) == sizeof(T), "atomic must be lock-free and unpadded");
+  for (unsigned i = 0; i < 64; i++) {
+    if (atomic.load(order) != old)
+      return;
+  }
+  while (atomic.load(order) == old)
+    WaitOnAddress((volatile void *)&atomic, &old, sizeof(T), INFINITE);
+#else
+  atomic.wait(old, order);
+#endif
+}
+
+template <typename T>
+inline void
+atomic_notify_one(std::atomic<T> &atomic) {
+#ifdef _WIN32
+  WakeByAddressSingle((void *)&atomic);
+#else
+  atomic.notify_one();
+#endif
+}
+
+template <typename T>
+inline void
+atomic_notify_all(std::atomic<T> &atomic) {
+#ifdef _WIN32
+  WakeByAddressAll((void *)&atomic);
+#else
+  atomic.notify_all();
+#endif
+}
+
+} // namespace dxmt
