F="$CX_ROOT/Frameworks"
export SikarugirAppWine11=1
export DYLD_FALLBACK_LIBRARY_PATH="$CX_ROOT/lib:$F:$F/GStreamer.framework/Libraries:/usr/lib"
export GST_PLUGIN_PATH="$F/GStreamer.framework/Libraries/gstreamer-1.0"
D="$F/renderer/${STEAMBRIDGE_D3DMETAL:-d3dmetal}"
export CX_D3DMETALPATH="$D"
export CX_APPLEGPT_LIBD3DSHARED_PATH="$D/external/libd3dshared.dylib"
export CX_APPLEGPTK_LIBD3DSHARED_PATH="$D/external/libd3dshared.dylib"
case "${STEAMBRIDGE_RENDERER:-d3dmetal}" in
  dxmt) export WINEDLLPATH_DXMT="$F/renderer/${STEAMBRIDGE_DXMT:-dxmt}/wine" WINEDLLPATH_PREPEND="$F/renderer/${STEAMBRIDGE_DXMT:-dxmt}/wine" ;;
  dxvk) export WINEDLLPATH_DXVK="$F/renderer/dxvk/wine" WINEDLLPATH_PREPEND="$F/renderer/dxvk/wine" DXVK_ASYNC="${DXVK_ASYNC:-1}" ;;
  *)    export WINEDLLPATH_D3DMETAL="$D/wine" WINEDLLPATH_PREPEND="$D/wine:$F/renderer/${STEAMBRIDGE_DXMT:-dxmt}/wine" ;;
esac
export CX_FWD_COMPAT_GL_CTX=1
export DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN=1
export MVK_CONFIG_RESUME_LOST_DEVICE=1
export ROSETTA_ADVERTISE_AVX="${ROSETTA_ADVERTISE_AVX:-1}"
export VK_DRIVER_FILES="$CX_ROOT/Resources/vulkan/icd.d/kosmickrisp_mesa_icd.json"
export WINEBOOT_HIDE_DIALOG=1
if [ "${STEAMBRIDGE_D9VK:-1}" = 1 ] && [ -f "$VK_DRIVER_FILES" ] && [ -d "$F/renderer/d9vk/wine" ]; then
  export WINEDLLPATH_D9VK="$F/renderer/d9vk/wine"
fi
if [ -z "${STEAMBRIDGE_RETINA:-}" ]; then
  case "$(osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSScreen.screens.objectAtIndex(0).backingScaleFactor' 2>/dev/null)" in
    1|1.0) STEAMBRIDGE_RETINA=0 ;;
  esac
fi
if [ "$verb" = waitforexitandrun ]; then
  disk_free_gb=$(df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ "$disk_free_gb" -lt "${STEAMBRIDGE_MIN_FREE_GB:-10}" ] 2>/dev/null; then
    case "$(osascript -e "display dialog \"Only $disk_free_gb GB is free on this Mac. A game that fills the disk can freeze the whole Mac.\" buttons {\"Not now\", \"Launch anyway\"} default button \"Not now\" with icon caution" 2>/dev/null)" in
      *"Not now"*) exit 0 ;;
    esac
  fi
fi
dx_win="$STEAM_COMPAT_DATA_PATH/pfx/drive_c/windows"
dx_mark="$STEAM_COMPAT_DATA_PATH/steambridge-directx"
if [ -n "$STEAM_COMPAT_DATA_PATH" ] && [ -d "$dx_win/syswow64" ] && [ ! -e "$dx_mark" ] &&
  [ -d "$STEAM_COMPAT_INSTALL_PATH" ] && dx_tmp=$(mktemp -d); then
  find "$STEAM_COMPAT_INSTALL_PATH" -maxdepth 4 -type f \( -iname '*_d3dx9_*.cab' -o -iname '*_d3dcompiler_*.cab' \) 2>/dev/null |
  while IFS= read -r dx_cab; do
    case "$dx_cab" in
      *_[xX]86.[cC][aA][bB]) dx_dir="$dx_win/syswow64" ;;
      *_[xX]64.[cC][aA][bB]) dx_dir="$dx_win/system32" ;;
      *) continue ;;
    esac
    rm -f "$dx_tmp"/*
    tar -xf "$dx_cab" -C "$dx_tmp" 2>/dev/null || continue
    for dx_dll in "$dx_tmp"/*.[dD][lL][lL]; do
      [ -f "$dx_dll" ] || continue
      dx_name=$(basename "$dx_dll" | tr '[:upper:]' '[:lower:]')
      dx_dst="$dx_dir/$dx_name"
      case "$(dd if="$dx_dst" bs=1 skip=64 count=16 2>/dev/null)" in
        "Wine builtin DLL"|"Wine placeholder") mv -f "$dx_dst" "$dx_dst.steambridge-orig" ;;
        "") ;;
        *) continue ;;
      esac
      mv -f "$dx_dll" "$dx_dst" && echo "$dx_name" >> "$dx_mark"
    done
  done || true
  rm -rf "$dx_tmp"
  touch "$dx_mark"
fi
if [ -s "$dx_mark" ]; then
  WINEDLLOVERRIDES="$(sort -u "$dx_mark" | sed 's/\.dll$/=n,b/' | tr '\n' ';')$WINEDLLOVERRIDES"
  export WINEDLLOVERRIDES
fi
