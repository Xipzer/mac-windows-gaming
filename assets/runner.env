F="$CX_ROOT/Frameworks"
export SikarugirAppWine11=1
export DYLD_FALLBACK_LIBRARY_PATH="$CX_ROOT/lib:$F:$F/GStreamer.framework/Libraries:/usr/lib"
export GST_PLUGIN_PATH="$F/GStreamer.framework/Libraries/gstreamer-1.0"
D="$F/renderer/${STEAMBRIDGE_D3DMETAL:-d3dmetal}"
export CX_D3DMETALPATH="$D"
export CX_APPLEGPT_LIBD3DSHARED_PATH="$D/external/libd3dshared.dylib"
export CX_APPLEGPTK_LIBD3DSHARED_PATH="$D/external/libd3dshared.dylib"
case "${STEAMBRIDGE_RENDERER:-d3dmetal}" in
  dxmt) export WINEDLLPATH_DXMT="$F/renderer/${STEAMBRIDGE_DXMT:-dxmt}/wine" ;;
  dxvk) export WINEDLLPATH_DXVK="$F/renderer/dxvk/wine" DXVK_ASYNC="${DXVK_ASYNC:-1}" ;;
  *)    export WINEDLLPATH_D3DMETAL="$D/wine" WINEDLLPATH_PREPEND="$D/wine" ;;
esac
export CX_FWD_COMPAT_GL_CTX=1
export DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN=1
export MVK_CONFIG_RESUME_LOST_DEVICE=1
export ROSETTA_ADVERTISE_AVX="${ROSETTA_ADVERTISE_AVX:-1}"
export VK_DRIVER_FILES="$CX_ROOT/Resources/vulkan/icd.d/kosmickrisp_mesa_icd.json"
export WINEBOOT_HIDE_DIALOG=1
