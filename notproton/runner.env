# Sourced by the NotProton run script: Sikarugir Wine 11 environment (mirrors Sikarugir's launcher)
F="$CX_ROOT/Frameworks"
export SikarugirAppWine11=1
export DYLD_FALLBACK_LIBRARY_PATH="$CX_ROOT/lib:$F:$F/GStreamer.framework/Libraries:/usr/lib"
export GST_PLUGIN_PATH="$F/GStreamer.framework/Libraries/gstreamer-1.0"
export WINEDLLPATH_D3DMETAL="$F/renderer/d3dmetal/wine"
export WINEDLLPATH_PREPEND="$F/renderer/d3dmetal/wine"
export CX_D3DMETALPATH="$F/renderer/d3dmetal"
export CX_APPLEGPT_LIBD3DSHARED_PATH="$F/renderer/d3dmetal/external/libd3dshared.dylib"
export CX_APPLEGPTK_LIBD3DSHARED_PATH="$F/renderer/d3dmetal/external/libd3dshared.dylib"
export CX_FWD_COMPAT_GL_CTX=1
export DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN=1
export MVK_CONFIG_RESUME_LOST_DEVICE=1
export ROSETTA_ADVERTISE_AVX=1
export VK_DRIVER_FILES="$CX_ROOT/Resources/vulkan/icd.d/kosmickrisp_mesa_icd.json"
export WINEBOOT_HIDE_DIALOG=1

if [ -f "$VK_DRIVER_FILES" ] && [ -d "$F/renderer/d9vk/wine" ]; then
  export WINEDLLPATH_D9VK="$F/renderer/d9vk/wine"
fi

# Wine scales every screen by one factor, so a 1x monitor reads as twice its size.
if [ -z "${NOTPROTON_RETINA:-}" ]; then
  case "$(osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSScreen.screens.objectAtIndex(0).backingScaleFactor' 2>/dev/null)" in
    1|1.0) NOTPROTON_RETINA=0 ;;
  esac
fi

if [ "$verb" = waitforexitandrun ]; then
  mwg_free_gb=$(df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }')
  if [ "$mwg_free_gb" -lt "${NOTPROTON_MIN_FREE_GB:-10}" ] 2>/dev/null; then
    case "$(osascript -e "display dialog \"Only $mwg_free_gb GB is free on this Mac. A game that fills the disk can freeze the whole Mac.\" buttons {\"Not now\", \"Launch anyway\"} default button \"Not now\" with icon caution" 2>/dev/null)" in
      *"Not now"*) exit 0 ;;
    esac
  fi
fi

# Steam's DirectX installscript never runs here (the run script skips iscriptevaluator). Scribblenauts Unlimited
# crashes on Wine's builtin d3dx9 effects and plays with the d3dx9 from its own redist cabs.
mwg_win="$STEAM_COMPAT_DATA_PATH/pfx/drive_c/windows"
mwg_mark="$STEAM_COMPAT_DATA_PATH/notproton-directx"
if [ -n "$STEAM_COMPAT_DATA_PATH" ] && [ -d "$mwg_win/syswow64" ] && [ ! -e "$mwg_mark" ] &&
  [ -d "$STEAM_COMPAT_INSTALL_PATH" ] && mwg_tmp=$(mktemp -d); then
  find "$STEAM_COMPAT_INSTALL_PATH" -maxdepth 4 -type f \( -iname '*_d3dx9_*.cab' -o -iname '*_d3dcompiler_*.cab' \) 2>/dev/null |
  while IFS= read -r mwg_cab; do
    case "$mwg_cab" in
      *_[xX]86.[cC][aA][bB]) mwg_dir="$mwg_win/syswow64" ;;
      *_[xX]64.[cC][aA][bB]) mwg_dir="$mwg_win/system32" ;;
      *) continue ;;
    esac
    rm -f "$mwg_tmp"/*
    tar -xf "$mwg_cab" -C "$mwg_tmp" 2>/dev/null || continue
    for mwg_dll in "$mwg_tmp"/*.[dD][lL][lL]; do
      [ -f "$mwg_dll" ] || continue
      mwg_name=$(basename "$mwg_dll" | tr '[:upper:]' '[:lower:]')
      mwg_dst="$mwg_dir/$mwg_name"
      case "$(dd if="$mwg_dst" bs=1 skip=64 count=16 2>/dev/null)" in
        "Wine builtin DLL"|"Wine placeholder") mv -f "$mwg_dst" "$mwg_dst.notproton-orig" ;;
        "") ;;
        *) continue ;;
      esac
      mv -f "$mwg_dll" "$mwg_dst" && echo "$mwg_name" >> "$mwg_mark"
    done
  done || true
  rm -rf "$mwg_tmp"
  touch "$mwg_mark"
fi
if [ -s "$mwg_mark" ]; then
  WINEDLLOVERRIDES="$(sort -u "$mwg_mark" | sed 's/\.dll$/=n,b/' | tr '\n' ';')$WINEDLLOVERRIDES"
  export WINEDLLOVERRIDES
fi
